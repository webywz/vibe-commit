# Optional. When set, vibe-commit drafts with an OpenAI-compatible API
# and falls back to the offline heuristic if the request fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Default vibe when --vibe is omitted: playful | pro | terse
VIBE_COMMIT_VIBE=pro
