{
  "name": "@webywz/vibe-commit",
  "version": "0.1.14",
  "description": "Stylish conventional commit messages with personality. Offline-first, AI-optional.",
  "keywords": [
    "git",
    "commit",
    "conventional-commits",
    "cli",
    "commit-message",
    "ai",
    "offline"
  ],
  "homepage": "https://github.com/webywz/vibe-commit#readme",
  "bugs": {
    "url": "https://github.com/webywz/vibe-commit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webywz/vibe-commit.git"
  },
  "license": "MIT",
  "author": "webywz",
  "type": "module",
  "bin": {
    "vibe-commit": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
